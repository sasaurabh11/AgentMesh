# ─── Database ────────────────────────────────────────────────────────────────
# Async URL used by FastAPI / SQLAlchemy at runtime
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orchestration

# Sync URL used only by Alembic migrations (auto-derived if omitted)
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/orchestration

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI Model Keys ───────────────────────────────────────────────────────────
# At least one key is required. Gemini has a free tier — recommended for quick start.

# Google AI Studio — free tier, supports Gemini 2.5 Flash / 2.0 Flash / Gemma
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI — powers GPT-4o and GPT-4o-mini (paid)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — powers Claude Opus / Sonnet / Haiku (paid)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Web Search ──────────────────────────────────────────────────────────────
# Tavily — used as primary backend for the web_search tool (1 000 free calls/month)
# Get yours at: https://app.tavily.com
# Falls back to DuckDuckGo when not set.
TAVILY_API_KEY=

# ─── Telegram Integration ────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram, then paste the token here
TELEGRAM_BOT_TOKEN=

# Optional: random string to verify webhook authenticity (recommended in production)
TELEGRAM_WEBHOOK_SECRET=

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# Used by the send_email tool. Gmail example shown — works with any SMTP server.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
# Set to false for servers that use plain SMTP without STARTTLS
SMTP_USE_TLS=true

# ─── Platform ────────────────────────────────────────────────────────────────
# Random secret used for signing internal tokens — change this in production!
SECRET_KEY=change-me-in-production

# CORS: comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public URL of this backend — used when registering the Telegram webhook
PUBLIC_BASE_URL=http://localhost:8000

# Absolute path where file-tool read/write operations are sandboxed
WORKSPACE_DIR=/path/to/your/workspace

# ─── Defaults ────────────────────────────────────────────────────────────────
# Model used for workflow summaries and background tasks
DEFAULT_SUMMARY_MODEL=gemini-2.5-flash

# Optional: pre-select a workflow for single-bot Telegram deployments
DEFAULT_WORKFLOW_ID=
